# Copy to .env and fill in. Only `make extract` and `make proof` need these;
# `make all` runs offline from data/snapshot/ without any of them.

# BigQuery (bigquery-public-data.crypto_near_mainnet_us)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
BQ_MAX_BYTES=10737418240

# NEAR Intents Explorer API (JWT, 1 request / 5 s)
INTENTS_EXPLORER_JWT=

# CoinGecko
COINGECKO_API_KEY=

# NEAR RPC (archival endpoint for historical blocks)
NEAR_RPC_URL=

# Proof of analysis: the manifest hash is committed to a NEAR network (testnet by default; no money).
# Use a dedicated account, never your own wallet. Keys live in the keychain of near-cli-rs; the
# private key variables are only for CI and belong in repository secrets, never in this file.
PROOF_NETWORK=testnet
PROOF_ACCOUNT_ID=
PROOF_CONTRACT_ID=
PROOF_PUBLIC_KEY=
PROOF_PRIVATE_KEY=
