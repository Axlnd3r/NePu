{
  "name": "video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "mediabunny": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "data": "node scripts/build-data.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check:audio": "node scripts/check-audio.mjs",
    "render:16x9": "npm run data && npm run check:audio && remotion render src/index.ts Demo16x9 out/nepu-demo-16x9.mp4",
    "render:1x1": "npm run data && npm run check:audio && remotion render src/index.ts Demo1x1 out/nepu-demo-1x1.mp4",
    "still": "npm run data && remotion still src/index.ts Demo16x9 out/cover.png --frame=670"
  },
  "allowScripts": {
    "esbuild": false
  }
}
